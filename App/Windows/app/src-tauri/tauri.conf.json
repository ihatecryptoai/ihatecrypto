{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ihatecrypto",
  "version": "0.1.0",
  "identifier": "app.ihatecrypto.windows",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ihatecrypto",
        "width": 1320,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "bin/*"
    ],
    "publisher": "ihatecrypto",
    "copyright": "GPL-3.0",
    "category": "Finance",
    "shortDescription": "A self-custody crypto wallet you talk to",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "Russian"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3QThEM0EzMjg5MjkzMzgKUldRNGs1SW9vOU9vRjJjK1pOOGZDNWJHNU1xby8wZFN6aFpUQnpzSitGVy9BWVVkZi9lYytzKzEK",
      "endpoints": [
        "https://github.com/ihatecryptoai/ihatecrypto/releases/download/windows-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
