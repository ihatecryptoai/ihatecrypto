{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: it talks to the engine through the app's own commands and listens to its events.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "updater:default",
    "allow-engine-send",
    "allow-protect",
    "allow-open-link",
    "allow-copy-secret",
    "allow-update-check",
    "allow-update-install",
    "allow-listen",
    "allow-open-browser"
  ]
}
