{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window's own page (webview «main», not the page panel beside the chat): it talks to the engine through the app's own commands and listens to its events.",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "updater:default",
    "allow-engine-send",
    "allow-protect",
    "allow-open-link",
    "allow-copy-secret",
    "allow-update-check",
    "allow-update-install",
    "allow-listen",
    "allow-open-browser",
    "allow-hide-main",
    "allow-quit-app",
    "allow-open-notification-settings",
    "allow-listen-live",
    "allow-listen-stop"
  ]
}
